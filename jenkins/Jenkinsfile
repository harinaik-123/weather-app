
pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = '713939171080.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPOSITORY = 'weather-app'
        IMAGE_NAME = 'weather-app'
        IMAGE_TAG = "${BUILD_NUMBER}"

        APP_URL = 'http://54.84.15.117:30080'

        KUBECONFIG = '/var/lib/jenkins/.kube/config'
        K8S_NAMESPACE = 'weather-app'
        K8S_DEPLOYMENT = 'weather-app'
        K8S_CONTAINER = 'weather-app'

        CI = 'true'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {

        stage('Git Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Secrets Scan - Gitleaks') {
            steps {
                sh '''
                    gitleaks git . \
                      --redact \
                      --exit-code 1
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    node --version
                    npm --version
                    npm ci
                '''
            }
        }

        stage('Unit Testing') {
            steps {
                sh '''
                    CI=true npm test -- \
                      --watchAll=false \
                      --passWithNoTests
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                // REACT_APP_ variables are public in the
                // compiled browser bundle.
                // Use only a key approved for client-side use.
                withCredentials([
                    string(
                        credentialsId: 'openweather-api-key',
                        variable: 'REACT_APP_OPENWEATHER_API_KEY'
                    )
                ]) {
                    sh '''
                        npm run build
                    '''
                }
            }
        }

        stage('SonarQube SAST Scan') {
            steps {
                script {
                    def scannerHome = tool(
                        name: 'sonar-scanner',
                        type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    )

                    withSonarQubeEnv('sonarqube') {
                        sh """
                            '${scannerHome}/bin/sonar-scanner'
                        """
                    }
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Snyk Dependency Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'snyk-token',
                        variable: 'SNYK_TOKEN'
                    )
                ]) {
                    sh '''
                        snyk test \
                          --all-projects \
                          --severity-threshold=high

                        snyk monitor --all-projects
                    '''
                }
            }
        }

        stage('Checkov IaC Scan') {
            steps {
                sh '''
                    checkov -d k8s \
                      --framework kubernetes
                '''
            }
        }

        stage('Docker Build') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'openweather-api-key',
                        variable: 'REACT_APP_OPENWEATHER_API_KEY'
                    )
                ]) {
                    sh '''
                        docker build \
                          --build-arg REACT_APP_OPENWEATHER_API_KEY \
                          -t "$IMAGE_NAME:$IMAGE_TAG" \
                          .
                    '''
                }
            }
        }

        stage('Snyk Container Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'snyk-token',
                        variable: 'SNYK_TOKEN'
                    )
                ]) {
                    sh '''
                        snyk container test \
                          "$IMAGE_NAME:$IMAGE_TAG" \
                          --file=Dockerfile \
                          --severity-threshold=high
                    '''
                }
            }
        }

        stage('Trivy Container Scan') {
            steps {
                sh '''
                    trivy image \
                      --exit-code 1 \
                      --severity HIGH,CRITICAL \
                      "$IMAGE_NAME:$IMAGE_TAG"
                '''
            }
        }

        stage('Push Docker Image to AWS ECR') {
            steps {
                sh '''
                    aws ecr describe-repositories \
                      --repository-names "$ECR_REPOSITORY" \
                      --region "$AWS_REGION"

                    aws ecr get-login-password \
                      --region "$AWS_REGION" |
                    docker login \
                      --username AWS \
                      --password-stdin "$ECR_REGISTRY"

                    docker tag \
                      "$IMAGE_NAME:$IMAGE_TAG" \
                      "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                    docker push \
                      "$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"
                '''
            }
        }

        stage('Resolve ECR Image Digest') {
            steps {
                sh '''
                    IMAGE_DIGEST=$(aws ecr describe-images \
                      --repository-name "$ECR_REPOSITORY" \
                      --region "$AWS_REGION" \
                      --image-ids imageTag="$IMAGE_TAG" \
                      --query 'imageDetails[0].imageDigest' \
                      --output text)

                    test -n "$IMAGE_DIGEST"
                    test "$IMAGE_DIGEST" != "None"

                    printf '%s@%s\\n' \
                      "$ECR_REGISTRY/$ECR_REPOSITORY" \
                      "$IMAGE_DIGEST" > image-reference.txt

                    cat image-reference.txt
                '''
            }
        }

        stage('Deploy to K3s Kubernetes') {
            steps {
                sh '''
                    test -r "$KUBECONFIG"

                    kubectl get nodes

                    kubectl apply -f k8s/namespace.yaml

                    kubectl -n "$K8S_NAMESPACE" \
                      create secret docker-registry ecr-registry-secret \
                      --docker-server="$ECR_REGISTRY" \
                      --docker-username=AWS \
                      --docker-password="$(aws ecr get-login-password --region "$AWS_REGION")" \
                      --dry-run=client -o yaml |
                    kubectl apply -f -

                    kubectl apply -f k8s/service.yaml

                    kubectl apply -f k8s/deployment.yaml

                    # Ensure the Deployment uses the ECR pull secret.
                    kubectl -n "$K8S_NAMESPACE" \
                      patch deployment "$K8S_DEPLOYMENT" \
                      --type=strategic \
                      -p '{"spec":{"template":{"spec":{"imagePullSecrets":[{"name":"ecr-registry-secret"}]}}}}'

                    IMAGE_REF=$(cat image-reference.txt)

                    kubectl -n "$K8S_NAMESPACE" \
                      set image \
                      deployment/"$K8S_DEPLOYMENT" \
                      "$K8S_CONTAINER=$IMAGE_REF"

                    kubectl -n "$K8S_NAMESPACE" \
                      rollout status \
                      deployment/"$K8S_DEPLOYMENT" \
                      --timeout=300s

                    # Apply network policy after rollout.
                    kubectl apply -f k8s/networkpolicy.yaml
                '''
            }
        }

        stage('OWASP ZAP DAST Scan') {
            steps {
                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'UNSTABLE'
                ) {
                    sh '''
                        docker run --rm \
                          --network host \
                          --user "$(id -u):$(id -g)" \
                          -v "$PWD:/zap/wrk:rw" \
                          -w /zap/wrk \
                          ghcr.io/zaproxy/zaproxy:stable \
                          zap-baseline.py \
                          -t "$APP_URL" \
                          -m 5 \
                          -r zap-report.html
                    '''
                }
            }
        }

        stage('Deployment Link') {
            steps {
                sh '''
                    printf 'Deployment Link: %s\\n' \
                      "$APP_URL" |
                    tee deployment-link.txt
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'zap-report.html,deployment-link.txt,image-reference.txt',
                allowEmptyArchive: true
            )

            sh '''
                docker image prune -f || true
            '''
        }

        success {
            echo 'DevSecOps pipeline completed successfully.'
        }

        unstable {
            echo 'Pipeline completed with security scan warnings.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs.'
        }
    }
}
