pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        ECR_REGISTRY = '736822755592.dkr.ecr.ap-south-1.amazonaws.com'
        ECR_REPOSITORY = 'weather-app'

        IMAGE_NAME = 'weather-app'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        IMAGE_FULL = "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

        SONAR_URL = 'http://13.207.2.142:9000'
        APP_URL = 'http://13.207.2.142:30080'

        GIT_REPO_NAME = 'weather-app'
        GIT_USER_NAME = 'harinaik-123'
        GIT_EMAIL = 'balaji123kousi@gmail.com'
        GIT_BRANCH = 'master'

        CI = 'true'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Secrets Scan') {
            steps {
                sh '''
                    gitleaks detect --source . --no-git
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    npm ci
                '''
            }
        }

        stage('Test') {
            steps {
                sh '''
                    CI=true npm test -- --watchAll=false --passWithNoTests
                '''
            }
        }

        stage('Build Frontend') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'openweather-api-key',
                        variable: 'REACT_APP_OPENWEATHER_API_KEY'
                    )
                ]) {
                    sh '''
                        npm run build
                    '''
                }
            }
        }

       stage('SAST') {
    steps {
        script {
            def scannerHome = tool 'sonar-scanner'

            withSonarQubeEnv('sonarqube') {
                sh """
                    ${scannerHome}/bin/sonar-scanner
                """
            }
        }
    }
}

      stage('Dependency Scan') {
    steps {
        withCredentials([
    string(credentialsId: 'snyk-token', variable: 'SNYK_TOKEN')
]) {
    sh 'snyk test --all-projects --severity-threshold=high'
      }
    }
}

        stage('Container Build') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'openweather-api-key',
                        variable: 'REACT_APP_OPENWEATHER_API_KEY'
                    )
                ]) {
                    sh '''
                        docker build \
                            --build-arg REACT_APP_OPENWEATHER_API_KEY \
                            -t "$IMAGE_FULL" .
                    '''
                }
            }
        }

        stage('Container Scan') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'snyk-token',
                        variable: 'SNYK_TOKEN'
                    )
                ]) {
                    sh '''
                        snyk test --docker "$IMAGE_FULL" \
                            --file=Dockerfile \
                            --severity-threshold=high
                    '''
                }

                sh '''
                    trivy image \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        "$IMAGE_FULL"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password \
                        --region "$AWS_REGION" | \
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"

                    docker push "$IMAGE_FULL"
                '''
            }
        }

        stage('Checkov - IaC Security Scan') {
            steps {
                sh '''
                    CHECKOV_VENV="$HOME/.checkov-venv"

                    if [ ! -x "$CHECKOV_VENV/bin/checkov" ]; then
                        python3 -m venv "$CHECKOV_VENV"
                        "$CHECKOV_VENV/bin/pip" install \
                            --upgrade pip checkov
                    fi

                    "$CHECKOV_VENV/bin/checkov" -d k8s
                '''
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('k8s') {
                    withCredentials([
                        string(
                            credentialsId: 'my-git-pattoken',
                            variable: 'GIT_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu
                            set +x

                            git config user.email "$GIT_EMAIL"
                            git config user.name "$GIT_USER_NAME"

                            IMAGE_DIGEST=$(aws ecr describe-images \
                                --repository-name "$ECR_REPOSITORY" \
                                --region "$AWS_REGION" \
                                --image-ids imageTag="$BUILD_NUMBER" \
                                --query 'imageDetails[0].imageDigest' \
                                --output text)

                            if [ -z "$IMAGE_DIGEST" ] || [ "$IMAGE_DIGEST" = "None" ]; then
                                echo "ECR image digest not found"
                                exit 1
                            fi

                            sed -i \
                                "s#image:.*#image: $ECR_REGISTRY/$ECR_REPOSITORY@$IMAGE_DIGEST#g" \
                                deployment.yaml

                            git add deployment.yaml

                            if ! git diff --cached --quiet; then
                                git commit -m "[skip ci] Update image to build $BUILD_NUMBER"
                            fi

                            AUTH_HEADER=$(printf '%s' \
                                "$GIT_USER_NAME:$GIT_TOKEN" | base64 | tr -d '\\n')

                            git -c http.extraheader="AUTHORIZATION: basic $AUTH_HEADER" \
                                push \
                                "https://github.com/$GIT_USER_NAME/$GIT_REPO_NAME.git" \
                                "HEAD:$GIT_BRANCH"
                        '''
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    mkdir -p "$HOME/.kube"

                    if [ ! -f "$HOME/.kube/config" ]; then

                        if sudo -n test -r /etc/rancher/k3s/k3s.yaml 2>/dev/null; then

                            sudo cp /etc/rancher/k3s/k3s.yaml \
                                "$HOME/.kube/config"

                            sudo chown "$(id -u):$(id -g)" \
                                "$HOME/.kube/config"

                        elif [ -r /etc/rancher/k3s/k3s.yaml ]; then

                            cp /etc/rancher/k3s/k3s.yaml \
                                "$HOME/.kube/config"

                        else
                            echo "Kubernetes kubeconfig unavailable"
                            exit 1
                        fi

                        chmod 600 "$HOME/.kube/config"
                    fi

                    export KUBECONFIG="$HOME/.kube/config"

                    kubectl apply -f k8s/namespace.yaml

                    aws ecr get-login-password \
                        --region "$AWS_REGION" | \
                    kubectl -n weather-app create secret \
                        docker-registry ecr-registry-secret \
                        --docker-server="$ECR_REGISTRY" \
                        --docker-username=AWS \
                        --docker-password-stdin \
                        --dry-run=client -o yaml
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution completed.'
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
